# Django
DJANGO_SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
NGROK_DOMAIN=

# Mongo
MONGO_URL=
MONGO_DB_NAME=QuickPrintDB
MONGO_DB_NAME_TEST=QuickPrintDB_test

# Auth — access+refresh split (OWASP-recommended). Short-lived JWT access token (all
# three roles share this lifetime) + long-lived opaque refresh token that silently mints
# new access tokens via each role's /refresh/ endpoint; refresh is rotated on every use
# with reuse-detection (see auth_handler.refresh_access_token).
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_SECONDS=1800
REFRESH_TOKEN_EXP_SECONDS=86400
ADMIN_TOKEN=

# App URLs — 8080 (quickprint-hub) and 8081 (quickprint-shop) match this workspace's
# convention shared with cafe-command-center/playhub-command/gaming-cafe-connect.
BACKEND_URL=http://localhost:8000
CUSTOMER_WEB_URL=http://localhost:8080
SHOP_DASHBOARD_URL=http://localhost:8081

# Google Sign-In
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cashfree (platform account, sandbox)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OTP auth — AES-256-CBC field encryption, used by ALL THREE roles (customer, shop_staff,
# super_admin) for register/login/verify-otp/resend-otp/forgot-password/reset-password.
# Generate your own: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
OTP_EXPIRY_MINUTES=10
SUPER_ADMIN_OTP_EXPIRY_MINUTES=2
MAX_OTP_ATTEMPTS=5
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
OTP_RESEND_COOLDOWN_SECONDS=45

# Brevo — transactional email for OTP codes. Leave blank for local dev (OTP prints to the
# console instead when DEBUG=True); required in production.
BREVO_API_KEY=
EMAIL_SENDER=QuickPrint <no-reply@quickprint.app>
SUPPORT_EMAIL=
